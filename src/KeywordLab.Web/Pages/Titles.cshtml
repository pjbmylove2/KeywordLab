@page
@using KeywordLab.Core.Titles
@model TitlesModel
@{
    ViewData["Title"] = "주제·제목 확정";
    var w = Model.Workshop;
}
<section class="kl-section">
    <div class="kl-head">
        <span class="kl-eyebrow">// 템플릿 생성 + 규칙 점수 → Codex로</span>
        <h1 class="kl-h1">주제·제목 확정</h1>
        <p class="kl-lead">플랫폼별 추천 제목을 고르고 Codex에 넘길 입력 블록을 복사합니다. 복사하면 키워드·플랫폼·제목·패턴·시각이 자동으로 기록됩니다.</p>
    </div>

    @if (string.IsNullOrWhiteSpace(Model.Keyword))
    {
        <div class="kl-empty">
            <p>키워드 직접 조회 결과에서 <strong>제목 정하기</strong>를 누르면 이 화면으로 옵니다.</p>
            <a class="kl-btn kl-btn-primary" href="/Lookup">키워드 직접 조회로 가기</a>
        </div>
    }
    else
    {
        <nav class="kl-tabs" aria-label="플랫폼">
            @foreach (var p in new[] { BlogPlatform.Tistory, BlogPlatform.Naver })
            {
                var href = $"/Titles?kw={Uri.EscapeDataString(Model.Keyword)}&topic={Uri.EscapeDataString(Model.Topic ?? string.Empty)}&platform={TitlesModel.PlatformValueOf(p)}";
                <a class="kl-tab @(Model.Platform == p ? "is-active" : null)" href="@href" aria-current="@(Model.Platform == p ? "page" : null)">@TitleLabels.Of(p)</a>
            }
        </nav>
        <p class="kl-muted">
            @if (Model.Platform == BlogPlatform.Tistory)
            {
                <text>티스토리: 40자 이내와 연도·월 표기에 가점, 금지 표현은 감점합니다.</text>
            }
            else
            {
                <text>네이버: 길이 제한은 없고, 같은 단어 반복·특수문자 남용·금지 표현을 감점합니다.</text>
            }
        </p>
    }

    @if (Model.ErrorMessage is not null)
    {
        <div class="kl-alert is-error" role="alert">@Model.ErrorMessage</div>
    }

    @if (w is not null && Model.Recommended is not null)
    {
        <div class="kl-panel">
            <dl class="kl-stats">
                <div><dt>핵심 키워드</dt><dd>@w.Keyword</dd></div>
                <div><dt>월 검색</dt><dd class="kl-mono">@(w.Volume?.TotalDisplay ?? "확인 안 됨")</dd></div>
                <div><dt>블로그 문서</dt><dd class="kl-mono">@w.BlogDocuments.ToString("N0")</dd></div>
            </dl>
            <p class="kl-muted">
                검색 의도 키워드:
                @if (w.IntentKeywords.Count == 0)
                {
                    <text>연관 키워드에서 찾지 못했습니다 (메인 키워드로 시작하는 연관 키워드가 없음).</text>
                }
                else
                {
                    @foreach (var i in w.IntentKeywords)
                    {
                        <span class="kl-chip">@i</span>
                    }
                }
            </p>
        </div>

        <form method="post" id="kl-title-form">
            <input type="hidden" name="kw" value="@Model.Keyword" />
            <input type="hidden" name="topic" value="@Model.Topic" />
            <input type="hidden" name="platform" value="@TitlesModel.PlatformValueOf(Model.Platform)" />

            <h2 class="kl-h2">제목 후보</h2>
            <p class="kl-muted">추천 1개와 대안 2개를 고르세요. 기본값은 점수 1위와, 그와 다른 패턴의 상위 제목입니다.</p>
            <div class="kl-table-wrap">
                <table class="kl-table">
                    <thead>
                        <tr>
                            <th scope="col">추천</th>
                            <th scope="col">대안</th>
                            <th scope="col">제목</th>
                            <th scope="col">패턴</th>
                            <th scope="col" class="is-num">점수</th>
                            <th scope="col">근거</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var row = 0; }
                        @foreach (var t in w.Ranked)
                        {
                            row++;
                            var id = $"kl-t{row}";
                            <tr>
                                <td><input type="radio" name="rec" value="@t.Text" id="@id-rec" aria-label="추천으로: @t.Text" checked="@(t == Model.Recommended)" /></td>
                                <td><input type="checkbox" name="alt" value="@t.Text" class="kl-alt" aria-label="대안으로: @t.Text" checked="@Model.Alternates.Contains(t)" /></td>
                                <td><label for="@id-rec">@t.Text</label></td>
                                <td>@TitleLabels.Of(t.Pattern)</td>
                                <td class="is-num kl-mono">@t.Score</td>
                                <td class="kl-reasons">
                                    @foreach (var r in t.Reasons)
                                    {
                                        <span class="kl-chip @(r.Points < 0 ? "is-minus" : null)">@r.Text @(r.Points > 0 ? "+" : null)@r.Points</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <label class="kl-small-title" for="kl-bg">이슈 배경 (선택, 참고용 · 검증 전)</label>
            <textarea id="kl-bg" name="bg" class="kl-textarea" rows="3" maxlength="@TitlesModel.MaxBackgroundLength"
                      placeholder="예: 11월부터 전기요금 인상 발표 (뉴스 자동 수집은 4단계)">@Model.IssueBackground</textarea>
            <div class="kl-card-actions">
                <button type="submit" class="kl-btn">선택으로 블록 다시 만들기</button>
            </div>
        </form>

        <h2 class="kl-h2">Codex 입력 블록</h2>
        <textarea id="kl-block" class="kl-textarea kl-mono" rows="18" readonly aria-label="Codex 입력 블록">@Model.Block</textarea>
        <form id="kl-save-form" method="post" asp-page-handler="Save">
            <input type="hidden" name="keyword" value="@w.Keyword" />
            <input type="hidden" name="platform" value="@TitlesModel.PlatformValueOf(w.Platform)" />
            <input type="hidden" name="title" value="@Model.Recommended.Text" />
            <input type="hidden" name="pattern" value="@Model.Recommended.Pattern" />
            <div class="kl-card-actions">
                <button type="submit" class="kl-btn kl-btn-primary" id="kl-copy-btn">블록 복사 (기록 저장)</button>
                <span id="kl-copy-status" class="kl-muted" role="status" aria-live="polite"></span>
            </div>
        </form>
    }
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('kl-title-form');
            if (form) {
                // 대안은 2개까지, 추천으로 고른 제목은 대안에서 뺀다.
                var alts = form.querySelectorAll('.kl-alt');
                function sync() {
                    var rec = form.querySelector('input[name=rec]:checked');
                    var checked = 0;
                    alts.forEach(function (a) {
                        if (rec && a.value === rec.value) { a.checked = false; }
                        if (a.checked) { checked++; }
                    });
                    alts.forEach(function (a) {
                        a.disabled = (!a.checked && checked >= 2) || (rec && a.value === rec.value);
                    });
                }
                form.addEventListener('change', sync);
                sync();
            }

            var save = document.getElementById('kl-save-form');
            if (!save) { return; }
            save.addEventListener('submit', async function (e) {
                e.preventDefault();
                var status = document.getElementById('kl-copy-status');
                var area = document.getElementById('kl-block');
                var copied = false;
                try {
                    await navigator.clipboard.writeText(area.value);
                    copied = true;
                } catch (err) {
                    // 클립보드 API가 막힌 브라우저: 블록을 선택해 예전 방식으로 복사한다.
                    area.focus();
                    area.select();
                    try { copied = document.execCommand('copy'); } catch (e) { copied = false; }
                }
                if (!copied) {
                    status.textContent = '클립보드에 복사하지 못했습니다. 블록을 직접 선택해 복사하세요. 기록은 저장하지 않았습니다.';
                    return;
                }
                try {
                    var res = await fetch(save.action, { method: 'POST', body: new FormData(save) });
                    var data = await res.json();
                    status.textContent = data.ok ? '복사하고 기록했습니다. Codex에 붙여 넣으세요.' : data.message;
                } catch (err) {
                    status.textContent = '복사는 됐지만 기록을 저장하지 못했습니다. 앱이 실행 중인지 확인하세요.';
                }
            });
        })();
    </script>
}
