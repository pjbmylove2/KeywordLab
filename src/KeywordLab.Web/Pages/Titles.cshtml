}
<partial name="_Upcoming" model="@(new KeywordLab.Web.Pages.Shared.UpcomingModel(2, "템플릿 생성 + 규칙 점수 → Codex로", "주제·제목 확정", "플랫폼별 추천 제목을 고르고 Codex에 넘길 입력 블록을 복사합니다."))" />
